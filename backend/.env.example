BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.210:3000

# Keep this unset unless the Windows PC is on a trusted private network.
# Browser clients should normally call code execution through the PC-hosted
# Next.js frontend, which proxies to the backend locally.
ORION_ALLOW_REMOTE_EXECUTION=0
